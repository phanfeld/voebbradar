Screen {
    background: #121212;
    align: center top;
}

Header {
    background: #1e1e2e;
    color: #cba6f7;
    text-style: bold;
}

Footer {
    background: #1e1e2e;
}

#search-container {
    width: 80%;
    margin-top: 1;
    height: auto;
}

#query-input {
    width: 75%;
    border: tall #89b4fa;
    background: #1e1e2e;
    color: #cdd6f4;
}

#query-input:focus {
    border: tall #a6e3a1;
}

#search-btn {
    width: 25%;
    margin-left: 1;
    background: #89b4fa;
    color: #11111b;
    text-style: bold;
    border: none;
}

#search-btn:hover {
    background: #a6e3a1;
}

#status-area {
    height: 3;
    margin-top: 1;
    content-align: center middle;
    color: #cdd6f4;
}

#book-selection-list {
    width: 80%;
    height: auto;
    max-height: 8;
    border: round #89b4fa;
    background: #1e1e2e;
    display: none; 
}

#results-table {
    width: 80%;
    height: 1fr;
    border: round #45475a;
    margin-top: 1;
    background: #121212;
    display: none; 
}

/* --- SETUP MODAL STYLES --- */
SetupScreen {
    align: center middle;
    background: rgba(18, 18, 18, 0.8);
}

#setup-container {
    width: 60%;
    height: auto;
    padding: 2 4;
    border: thick #cba6f7;
    background: #1e1e2e;
    align: center middle;
}

#setup-title {
    text-align: center;
    margin-bottom: 1;
    color: #cdd6f4;
}

.setup-label {
    width: 100%;
    color: #a6e3a1;
    margin-top: 1;
}

#branches-input, #languages-input {
    width: 100%;
    margin-bottom: 1;
}

#save-config-btn {
    width: 100%;
    margin-top: 1;
}